{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {"name": "api-made"},
  "spec": {
    "replicas": 1,
    "selector": {"matchLabels": {"app": "api-made"}},
    "template": {
      "metadata": {"labels": {"app": "api-made"}},
      "spec": {"containers": [{"name": "nginx", "image": "nginx:1.27"}]}}}}
